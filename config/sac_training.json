{
  "schema_version": 1,
  "backend": "physics",
  "run_name": "sac_training",
  "description": "Local four-stage SAC training for the 11-D three-loop PIDF tuner with DOBC integrated into the speed stage.",
  "default_device": "cuda",
  "seeds": [
    20260801,
    20260802,
    20260803
  ],
  "stages": [
    {
      "name": "current",
      "total_timesteps": 30000
    },
    {
      "name": "speed",
      "total_timesteps": 70000
    },
    {
      "name": "position",
      "total_timesteps": 40000
    },
    {
      "name": "joint",
      "total_timesteps": 120000
    }
  ],
  "plant_sampling": {
    "mode": "difficulty",
    "uniform_fraction": 0.3,
    "warmup_episodes_per_model": 2,
    "ema_rate": 0.1,
    "cost_clip": 100,
    "margin_clip": 10,
    "score_floor": 0.05,
    "hardness_exponent": 1,
    "maximum_probability": 0.1
  },
  "environment": {
    "max_episode_steps": 32,
    "audit_interval": 64,
    "initial_perturbation": 0.02
  },
  "sac": {
    "policy": "MultiInputPolicy",
    "learning_rate": 0.0003,
    "buffer_size": 50000,
    "learning_starts": 2000,
    "batch_size": 256,
    "tau": 0.005,
    "gamma": 0.98,
    "train_frequency": 1,
    "gradient_steps_per_transition": 1,
    "network_architecture": [
      256,
      256
    ]
  },
  "parallelism": {
    "environments_per_seed": 4,
    "concurrent_seeds": 3,
    "start_method": "auto",
    "numerical_threads_per_process": 1
  },
  "checkpoint": {
    "interval_timesteps": 10000,
    "save_replay_buffer": true,
    "keep_last": 2
  },
  "validation": {
    "interval_timesteps": 10000,
    "candidate_pool_size": 64,
    "periodic_candidate_limit": 4,
    "stage_finalist_limit": 3,
    "minimum_cost_improvement": 1e-06
  },
  "tensorboard": {
    "enabled": true,
    "subdirectory": "tensorboard"
  },
  "runtime": {
    "minimum_free_disk_gb": 10.0,
    "progress_bar": false,
    "progress_interval_timesteps": 1000,
    "torch_deterministic_algorithms": false
  },
  "isolation": {
    "training_models": 40,
    "validation_models": 16,
    "candidate_selection_source": "training_and_validation_only",
    "sealed_evaluation_available_during_training": false
  }
}
