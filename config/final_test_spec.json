{
  "schema_version": 2,
  "test_suite_id": "physics_motor_six_metric_final_test_v2",
  "description": "Sealed, test-only 24-model generalization suite for the physics three-loop PIDF controller with DOBC embedded in the speed loop.",
  "isolation_policy": {
    "allowed_consumers": [
      "scripts/run_final_test.py",
      "tests/test_final_test_dataset_integrity.py"
    ],
    "forbidden_uses": [
      "reward computation",
      "SAC replay-buffer generation",
      "early stopping",
      "hyperparameter selection",
      "controller candidate selection",
      "training or validation audit"
    ],
    "evaluate_candidate_before_training_is_locked": false,
    "final_report_write_once": true
  },
  "frozen_source": {
    "physics_config": "config/motor_physics.json",
    "performance_targets": "config/controller_performance_targets.json",
    "training_validation_ensemble": "data/processed/physics_motor_ensemble.npz",
    "training_models": 40,
    "validation_models": 16,
    "training_validation_seed": 20260722
  },
  "in_distribution_test": {
    "model_count": 16,
    "seed": 20260723,
    "sampling": "independent_stratified_uniform",
    "uncertainty": "inherit exactly from config/motor_physics.json",
    "nominal_model_included": false,
    "minimum_normalized_chebyshev_distance_from_train_validation": 0.02
  },
  "ood_test": {
    "model_count": 8,
    "meaning": "simulation stress envelope only; not a claim about hardware tolerances",
    "corner_models": [
      {
        "model_id": "ood_01_low_torque_high_inertia_delay",
        "multipliers": {
          "torque_constant_nm_per_a": 0.9,
          "inertia_kg_m2": 1.15,
          "viscous_friction_nm_s_per_rad": 0.9,
          "current_delay_s": 1.2,
          "speed_measurement_delay_s": 1.2,
          "position_measurement_delay_s": 1.2
        }
      },
      {
        "model_id": "ood_02_low_damping_high_inertia",
        "multipliers": {
          "torque_constant_nm_per_a": 0.95,
          "inertia_kg_m2": 1.15,
          "viscous_friction_nm_s_per_rad": 0.85,
          "speed_measurement_delay_s": 1.1,
          "position_measurement_delay_s": 1.1
        }
      },
      {
        "model_id": "ood_03_slow_electrical_dynamics",
        "multipliers": {
          "inductance_h": 1.1,
          "resistance_ohm": 0.9,
          "current_delay_s": 1.2
        }
      },
      {
        "model_id": "ood_04_high_resistance_current_delay",
        "multipliers": {
          "inductance_h": 0.9,
          "resistance_ohm": 1.1,
          "current_delay_s": 1.2
        }
      },
      {
        "model_id": "ood_05_high_gain_low_inertia",
        "multipliers": {
          "torque_constant_nm_per_a": 1.1,
          "inertia_kg_m2": 0.85,
          "viscous_friction_nm_s_per_rad": 0.9,
          "current_delay_s": 0.9,
          "speed_measurement_delay_s": 0.9,
          "position_measurement_delay_s": 0.9
        }
      },
      {
        "model_id": "ood_06_all_measurement_delays_high",
        "multipliers": {
          "current_delay_s": 1.2,
          "speed_measurement_delay_s": 1.2,
          "position_measurement_delay_s": 1.2,
          "torque_constant_nm_per_a": 1.05,
          "inertia_kg_m2": 0.9
        }
      },
      {
        "model_id": "ood_07_low_damping_low_torque",
        "multipliers": {
          "viscous_friction_nm_s_per_rad": 0.85,
          "torque_constant_nm_per_a": 0.9,
          "inertia_kg_m2": 1.1,
          "speed_measurement_delay_s": 1.15
        }
      },
      {
        "model_id": "ood_08_combined_adverse_corner",
        "multipliers": {
          "inductance_h": 1.1,
          "resistance_ohm": 1.1,
          "current_delay_s": 1.2,
          "viscous_friction_nm_s_per_rad": 0.85,
          "speed_measurement_delay_s": 1.2,
          "inertia_kg_m2": 1.15,
          "torque_constant_nm_per_a": 0.9,
          "position_measurement_delay_s": 1.2
        }
      }
    ]
  },
  "reference_steps": {
    "current_reference_a": 0.5,
    "speed_reference_rad_s": 1.0,
    "position_reference_rad": 0.002,
    "encoder_effects": false
  },
  "acceptance_policy": {
    "official_metrics_per_loop": [
      "closed_loop_bandwidth_hz",
      "gain_margin_db",
      "phase_margin_deg",
      "overshoot_ratio",
      "rise_time_s",
      "settling_time_s"
    ],
    "targets_source": "config/controller_performance_targets.json",
    "bandwidth_reporting_tolerance_fraction": 0.1,
    "bandwidth_tolerance_semantics": "Algorithmic reporting and pass tolerance around the stated bandwidth target; it is the same normalization scale used by the six-metric cost and is not an additional physical metric.",
    "gain_and_phase_margins_are_minima": true,
    "overshoot_rise_and_settling_are_maxima": true,
    "invalid_or_nonfinite_metric_fails_model": true,
    "all_three_loops_must_pass_per_model": true,
    "all_24_models_must_pass_suite": true,
    "diagnostics_outside_the_six_metrics_are_forbidden": [
      "disturbance metrics",
      "loop hierarchy ratios",
      "sensitivity peak",
      "IAE",
      "steady-state error",
      "control effort"
    ]
  },
  "output_policy": {
    "test_ensemble": "data/processed/physics_motor_six_metric_test_v2.npz",
    "test_manifest": "data/processed/physics_motor_six_metric_test_v2_manifest.json",
    "final_report": "outputs/final_test_v2/final_test_report.json",
    "consumption_marker": "outputs/final_test_v2/FINAL_TEST_CONSUMED.json"
  }
}
